import tkinter as tk
from tkinter import messagebox

def on_button_click():
    messagebox.showinfo("Информация", "Кнопка была успешно нажата!")

def create_interface():
    root = tk.Tk()
)
    root.title("ADO.NET Course — Урок 8")
    root.geometry("400x250")
    
    try:
        root.iconbitmap("app_icon.ico")
    except Exception:
        pass  # Игнорируем, если иконка не найдена

    label = tk.Label(
        root, 
        text="Добро пожаловать в приложение!", 
        font=("Arial", 12),
        pady=20
    )
    label.pack()

    button = tk.Button(
        root, 
        text="Нажми меня", 
        command=on_button_click,
        font=("Arial", 10),
        padx=15,
        pady=5
    )
    button.pack()

    root.mainloop()

if __name__ == "__main__":
    create_interface()
